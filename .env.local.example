# Copy this file to .env.local and fill in your Supabase project's values.
# Find these in your Supabase dashboard: Project Settings → API.

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Used to build absolute URLs in the sitemap and robots.txt.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# Optional. Guess the Spot's map falls back to free OpenStreetMap tiles
# when this is unset. Set it to switch to Esri's styled vector basemap
# instead — get a token from an ArcGIS Location Platform account
# (https://location.arcgis.com), which meters/bills usage.
NEXT_PUBLIC_ESRI_TOKEN=
